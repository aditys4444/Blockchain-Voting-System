{
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/stitch",
      "destination": "/stitch_redesign/index.html"
    },
    {
      "source": "/redesign",
      "destination": "/stitch_redesign/index.html"
    },
    {
      "source": "/((?!stitch_redesign).*)",
      "destination": "/index.html"
    }
  ]
}
