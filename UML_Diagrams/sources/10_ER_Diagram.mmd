erDiagram
    USERS ||--o{ ELECTIONS : creates
    ELECTIONS ||--|{ CANDIDATES : contains
    USERS ||--o{ VOTE_RECEIPTS : casts
    ELECTIONS ||--o{ VOTE_RECEIPTS : records
    USERS ||--o{ AUDIT_LOGS : generates

    USERS {
        int id PK
        string email UK
        string username UK
        string hashed_password
        string role
        boolean is_active
        datetime created_at
    }

    ELECTIONS {
        int id PK
        string title
        string description
        string status
        datetime start_time
        datetime end_time
        int created_by FK
    }

    CANDIDATES {
        int id PK
        int election_id FK
        string name
        string party
        string manifesto
        string avatar_url
        int vote_count
    }

    VOTE_RECEIPTS {
        int id PK
        int user_id FK
        int election_id FK
        int candidate_id FK
        string voter_hash UK
        string encrypted_vote
        string tx_hash UK
        int block_index
        string receipt_hash UK
        datetime created_at
    }

    AUDIT_LOGS {
        int id PK
        int user_id FK
        string user_email
        string action
        string details
        string ip_address
        datetime timestamp
    }
