{
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "cd frontend && npm install --legacy-peer-deps",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/stitch",
      "destination": "/stitch_redesign/index.html"
    },
    {
      "source": "/redesign",
      "destination": "/stitch_redesign/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
